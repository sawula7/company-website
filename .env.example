# Google reCAPTCHA v3 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin

# reCAPTCHA Site Key (public key - used in frontend)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# reCAPTCHA Secret Key (private key - used in backend for verification)
# WARNING: Never expose this key in frontend code or commit to version control
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Maps Embed API Key
# Get your key from: https://console.cloud.google.com/ → Enable Maps Embed API
# Restrict the key to your domain for security
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
