# Google reCAPTCHA v3 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin

# reCAPTCHA Site Key (public key - used in frontend)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# reCAPTCHA Secret Key (private key - used in backend for verification)
# WARNING: Never expose this key in frontend code or commit to version control
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Maps Embed API Key
# Get your key from: https://console.cloud.google.com/ → Enable Maps Embed API
# Restrict the key to your domain for security
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# EmailJS Configuration
# Sign up at https://www.emailjs.com/ and follow these steps:
# 1. Create a Service (connect your email account e.g. Gmail)
# 2. Create two Email Templates:
#    - Company template: receives enquiry at info@beetech.lk
#    - Auto-reply template: sends thank you email to customer
# 3. Copy your Public Key from Account → API Keys
#
# Template variables available: {{from_name}}, {{from_email}}, {{company}}, {{message}}, {{to_email}}
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_COMPANY_TEMPLATE_ID=your_company_template_id_here
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
